# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Stripe Configuration
REACT_APP_ENV=development
STRIPE_SECRET_KEY_TEST=your_stripe_test_secret_key
STRIPE_SECRET_KEY=your_stripe_live_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_MANAGED_LEAGUE_PRICE_ID=your_managed_league_price_id
STRIPE_SELF_MANAGED_LEAGUE_PRICE_ID=your_self_managed_league_price_id

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Global League Configuration
# Live Global. Signup alias "global" joins this league (no Stripe Checkout).
# After the 2026-27 cutover, set this to the id printed by
# scripts/season-cutover-2026-27.js. Do not commit the real id.
GLOBAL_LEAGUE_ID=your_global_league_id

# Optional. 2025-2026 Global id, used only for that season's matchday labels.
# Defaults to 351a1949-f6c5-4940-ac70-1c7dd08e8b1a. Do not point this at the new Global.
# LEGACY_GLOBAL_LEAGUE_ID=

# Optional override for the season-cutover script if CNBeras is not named "CNBeras".
# CNBERAS_LEAGUE_ID=

# Scraper Configuration
SCRAPER_USE_RFEN=false
